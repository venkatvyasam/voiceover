{
  "description": "voiceover: read Claude's replies aloud, stop when you type, and set up the voice on first use",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/session_start.sh\"" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "\"$HOME/.claude/voiceover/.venv/bin/python\" \"${CLAUDE_PLUGIN_ROOT}/speak_reply.py\" 2>/dev/null || true" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/voice\" --on-prompt 2>/dev/null || true" } ] }
    ]
  }
}

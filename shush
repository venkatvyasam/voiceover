#!/bin/bash
# Controls for the Claude Code voice-over. `shush -h` lists every option.
DIR=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)   # this repo, even when run through ~/.local/bin/shush
PY="$DIR/.venv/bin/python"
LOG="$DIR/speak.log"
SESSION_MUTE_DIR=~/.claude/speak-muted

stop_all() {
  pkill -f "$DIR/speak.py" 2>/dev/null; pkill -x afplay 2>/dev/null
  pkill -CONT -f "$DIR/speak.py" 2>/dev/null; pkill -CONT -x afplay 2>/dev/null  # a paused process only dies once resumed
}

usage() {
  cat <<'EOF'
shush: controls for the Claude Code voice-over
(inside Claude Code, prefix with !  e.g.  ! shush -p)

  shush              stop speaking now
  shush -p           pause
  shush -r           resume
  shush -a           say the last reply again
  shush status       what's muted, what's playing, last reply spoken or skipped
  shush -m / -u      mute / unmute every session
  shush -s           mute only this Claude Code session   (! shush -s)
  shush -s off       unmute this session
  shush -h           this help

Speech also stops by itself when you send your next message.
Start a silent session:  SPEAK=0 claude
EOF
}

status() {
  echo "Voice-over status"
  if [ -e ~/.claude/.speak-off ]; then echo "  All sessions:  MUTED  (shush -u to unmute)"; else echo "  All sessions:  on"; fi
  if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
    if [ -e "$SESSION_MUTE_DIR/$CLAUDE_CODE_SESSION_ID" ]; then echo "  This session:  MUTED  (! shush -s off to unmute)"
    elif [ "${SPEAK:-}" = "0" ]; then echo "  This session:  silent (started with SPEAK=0)"
    else echo "  This session:  on"; fi
  else
    echo "  This session:  run as '! shush status' inside Claude Code to see"
  fi
  local pid; pid=$(pgrep -x afplay | head -1)
  if [ -n "$pid" ]; then
    case "$(ps -o stat= -p "$pid")" in T*) echo "  Playback:      paused  (shush -r to resume)" ;; *) echo "  Playback:      speaking" ;; esac
  elif pgrep -f "$DIR/speak.py" >/dev/null; then echo "  Playback:      preparing speech"
  else echo "  Playback:      idle"; fi
  echo "  Voice:         $(sed -n 's/^VOICE = "\([^"]*\)".*/\1/p' "$DIR/speak.py") at $(sed -n 's/^SPEED = \([0-9.]*\).*/\1/p' "$DIR/speak.py")x speed"
  if [ -s "$DIR/last.wav" ]; then echo "  Repeat (-a):   ready, instant"
  elif [ -s "$DIR/last.txt" ]; then echo "  Repeat (-a):   regenerates (~5s)"
  else echo "  Repeat (-a):   nothing yet"; fi
  # Last hook decision: this session's if we know it, else the most recent overall.
  local last=""
  [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] && last=$(grep "^--- .*\[${CLAUDE_CODE_SESSION_ID:0:8}\]" "$LOG" 2>/dev/null | tail -1)
  [ -z "$last" ] && last=$(grep '^--- ' "$LOG" 2>/dev/null | tail -1)
  if [ -n "$last" ]; then echo "  Last reply:    ${last#--- }"; else echo "  Last reply:    nothing logged yet"; fi
}

case "${1:-}" in
  "")          stop_all; echo "stopped" ;;
  -p|--pause)  pkill -STOP -x afplay 2>/dev/null && echo "paused — 'shush -r' to resume" || echo "nothing playing" ;;
  -r|--resume) pkill -CONT -x afplay 2>/dev/null && echo "resumed" || echo "nothing paused" ;;
  -a|--again)  [ -s "$DIR/last.txt" ] || { echo "nothing to repeat yet"; exit 0; }
               stop_all
               if [ -s "$DIR/last.wav" ]; then   # saved audio: instant
                 nohup afplay "$DIR/last.wav" >/dev/null 2>&1 &
               else                              # reply was cut off before it finished generating
                 nohup "$PY" "$DIR/speak.py" "$(cat "$DIR/last.txt")" >/dev/null 2>&1 &
               fi
               echo "repeating last reply" ;;
  -s|--session)
               [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] || { echo "run this inside Claude Code as: ! shush -s"; exit 1; }
               if [ "${2:-}" = "off" ]; then
                 rm -f "$SESSION_MUTE_DIR/$CLAUDE_CODE_SESSION_ID"; echo "this session unmuted"
               else
                 stop_all; mkdir -p "$SESSION_MUTE_DIR"; touch "$SESSION_MUTE_DIR/$CLAUDE_CODE_SESSION_ID"
                 echo "this session muted — '! shush -s off' to unmute"
               fi ;;
  -m|--mute)   stop_all; touch ~/.claude/.speak-off; echo "muted — 'shush -u' to unmute" ;;
  -u|--unmute) rm -f ~/.claude/.speak-off; echo "unmuted" ;;
  status|--status) status ;;
  -h|--help|help) usage ;;
  --on-prompt) # UserPromptSubmit hook: stop the old reply when you send a new message.
               # Silent on purpose: this hook's output would be added to Claude's context.
               # A prompt about shush itself (e.g. asking Claude to resume) must not stop the speech it targets.
               prompt=$("$PY" -c 'import json,sys; print(json.load(sys.stdin).get("prompt") or "")' 2>/dev/null)
               case "$prompt" in *shush*|*sush*) ;; *) stop_all ;; esac
               exit 0 ;;
  *)           echo "shush: unknown option '$1' (nothing was stopped)"; echo; usage; exit 1 ;;
esac

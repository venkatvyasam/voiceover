#!/bin/bash
# Controls for the Claude Code voice-over. Installed as `voice` and the short form `vo`.
# `voice help` lists every command.
DIR=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)   # the code (in a plugin, its folder changes with every update)
DATA="${VOICEOVER_DATA:-$HOME/.claude/voiceover}"      # the voice, log and saved replies
PY="$DATA/.venv/bin/python"
LOG="$DATA/speak.log"
SESSION_MUTE_DIR=~/.claude/speak-muted
SPEED_FILE=~/.claude/speak-speed
NUMBER='^[+-]?([0-9]+\.?[0-9]*|\.[0-9]+)$'   # 1.3, +.2, -0.1, 2

# The reading speed: the one saved by `vo 1.3` or `vo +.2`, else the default in speak.py.
current_speed() {
  local s; s=$(cat "$SPEED_FILE" 2>/dev/null)
  [[ "$s" =~ ^[0-9]*\.?[0-9]+$ ]] || s=$(sed -n 's/^SPEED = \([0-9.]*\).*/\1/p' "$DIR/speak.py")
  echo "$s"
}

# `vo 1.3` sets the speed; `vo +.2` and `vo -.1` change it by that much; `vo reset` goes back
# to the default in speak.py. Kokoro accepts 0.5 to 2.
set_speed() {
  local old new clamped=0
  old=$(current_speed)
  if [ "$1" = reset ]; then
    rm -f "$SPEED_FILE"; new=$(current_speed)
  else
    read -r new clamped < <(awk -v old="$old" -v arg="$1" 'BEGIN {
      v = (arg ~ /^[+-]/) ? old + arg : arg + 0
      c = (v < 0.5 || v > 2) ? 1 : 0
      if (v < 0.5) v = 0.5; if (v > 2) v = 2
      s = sprintf("%.2f", v); sub(/0+$/, "", s); sub(/\.$/, "", s)
      print s, c }')
    echo "$new" > "$SPEED_FILE"
  fi
  rm -f "$DATA/last.wav"   # the saved audio is at the old speed, so `voice again` makes it fresh at the new one
  if [ "$clamped" = 1 ]; then echo "speed ${new}x (was ${old}x; the range is 0.5 to 2)"
  else echo "speed ${new}x (was ${old}x)"; fi
  # A replay plays a finished recording, so its speed is fixed.
  if ps -o command= -p "$(speech_pid)" 2>/dev/null | grep -q -- "--play"; then echo "the replay playing now keeps its speed; the next reply, or vo a, uses ${new}x"; fi
}

# What `voice again` repeats: inside Claude Code, that session's last spoken reply; elsewhere, the last from any session.
again_file() {
  if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then echo "$DATA/last-by-session/$CLAUDE_CODE_SESSION_ID.txt"; else echo "$DATA/last.txt"; fi
}

# last.wav is the audio of last.txt, so it can be replayed only when that's the text we want.
saved_audio_matches() { [ -s "$DATA/last.wav" ] && cmp -s "$1" "$DATA/last.txt"; }

# The process number of the speak.py that is speaking now, if any. It writes speak.pid; the check
# that the number still belongs to speak.py stops us signalling some other program.
speech_pid() { local p; p=$(cat "$DATA/speak.pid" 2>/dev/null) && ps -o command= -p "$p" 2>/dev/null | grep -q "speak.py" && echo "$p"; }
engine_pid() { local p; p=$(cat "$DATA/voice_server.lock" 2>/dev/null) && ps -o command= -p "$p" 2>/dev/null | grep -q "voice_server.py" && echo "$p"; }

stop_all() { local p; p=$(speech_pid) && kill "$p" 2>/dev/null; rm -f "$DATA/speak.state" "$DATA/speak.pid"; }

# What speak.py is doing: preparing, speaking or paused (it keeps speak.state up to date); empty if idle.
playback() { speech_pid >/dev/null && cat "$DATA/speak.state" 2>/dev/null; }

usage() {
  cat <<'EOF'
voice: controls for the Claude Code voice-over   (vo is the short form)
Inside Claude Code, start with !   e.g.  ! voice pause

  voice stop          stop speaking now                        vo s
  voice pause         pause                                    vo p
  voice resume        continue where it paused                 vo r
  voice again         say this session's last reply again      vo a
  voice +.2           speak faster by 0.2 (use - for slower)   vo -.1
  voice 1.3           set the speed (0.5 to 2)                 vo 1.3
  voice reset         speed back to the default (1.1)
  voice status        what's muted or playing, and why the last reply was spoken or skipped
  voice mute          mute every session
  voice unmute        unmute every session
  voice mute here     mute only this Claude Code session
  voice unmute here   unmute this session
  voice read FILE     read a document aloud with readalong, if it is installed
  voice help          this list

Speech also stops by itself when you send your next message.
Start a silent session:  SPEAK=0 claude
EOF
}

status() {
  echo "Voice-over status"
  if [ -e ~/.claude/.speak-off ]; then echo "  All sessions:  MUTED  (voice unmute)"; else echo "  All sessions:  on"; fi
  if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
    if [ -e "$SESSION_MUTE_DIR/$CLAUDE_CODE_SESSION_ID" ]; then echo "  This session:  MUTED  (! voice unmute here)"
    elif [ "${SPEAK:-}" = "0" ]; then echo "  This session:  silent (started with SPEAK=0)"
    else echo "  This session:  on"; fi
  else
    echo "  This session:  run '! voice status' inside Claude Code to see"
  fi
  case "$(playback)" in
    paused)    echo "  Playback:      paused  (voice resume)" ;;
    speaking)  echo "  Playback:      speaking" ;;
    preparing) echo "  Playback:      preparing speech" ;;
    *)         echo "  Playback:      idle" ;;
  esac
  if [ ! -x "$PY" ] || [ ! -s "$DATA/models/kokoro-v1.0.onnx" ]; then
    if [ -d "$DATA/setup.lock" ]; then echo "  Setup:         downloading the voice now (see $DATA/setup.log)"
    else echo "  Setup:         not done yet (it runs by itself at the next session start, or run /voiceover:setup)"; fi
  fi
  if [ -n "$(engine_pid)" ]; then echo "  Voice engine:  loaded (quick start; quits after 45 minutes unused)"
  else echo "  Voice engine:  not loaded (the next reply takes ~6s to start)"; fi
  echo "  Voice:         $(sed -n 's/^VOICE = "\([^"]*\)".*/\1/p' "$DIR/speak.py") at $(current_speed)x speed  (vo +.2 faster, vo -.1 slower)"
  local again; again=$(again_file)
  if [ ! -s "$again" ]; then echo "  Again:         nothing spoken yet"
  elif saved_audio_matches "$again"; then echo "  Again:         ready, instant"
  else echo "  Again:         regenerates (~3s)"; fi
  # Last hook decision: this session's if we know it, else the most recent overall.
  local last=""
  [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] && last=$(grep "^--- .*\[${CLAUDE_CODE_SESSION_ID:0:8}\]" "$LOG" 2>/dev/null | tail -1)
  [ -z "$last" ] && last=$(grep '^--- ' "$LOG" 2>/dev/null | tail -1)
  if [ -n "$last" ]; then echo "  Last reply:    ${last#--- }"; else echo "  Last reply:    nothing logged yet"; fi
}

need_session() {
  [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] || { echo "run this inside Claude Code, with ! in front:  ! voice $1 here"; exit 1; }
}

# A number is a speed, checked before the dashes below are stripped: "-.1" means slower, not ".1".
if [[ "${1:-}" =~ $NUMBER ]]; then set_speed "$1"; exit 0; fi

# Accept words or short forms, with or without dashes: "stop", "-stop", "s" all work.
cmd=$(printf '%s' "${1:-help}" | tr '[:upper:]' '[:lower:]' | sed 's/^-*//')
where=$(printf '%s' "${2:-}" | tr '[:upper:]' '[:lower:]')

case "$cmd" in
  stop|s)      stop_all; echo "stopped" ;;
  pause|p)     # speak.py holds its exact place (SIGUSR1); also works before the first sound.
               if [ -n "$(playback)" ]; then kill -USR1 "$(speech_pid)"; echo "paused (voice resume to continue)"
               else echo "nothing playing"; fi ;;
  resume|r|continue)
               if [ "$(playback)" = paused ]; then kill -USR2 "$(speech_pid)"; echo "resumed"
               else echo "nothing paused"; fi ;;
  again|a|repeat|replay)
               text=$(again_file)
               [ -s "$text" ] || { echo "nothing spoken yet to repeat"; exit 0; }
               stop_all
               if saved_audio_matches "$text"; then   # saved audio: instant
                 nohup "$PY" "$DIR/speak.py" --play "$DATA/last.wav" >/dev/null 2>&1 &
               else                                   # another session spoke since, or the reply was cut off
                 nohup "$PY" "$DIR/speak.py" "$(cat "$text")" >/dev/null 2>&1 &
               fi
               echo "saying the last reply again" ;;
  status|st)   status ;;
  mute|m)      if [ "$where" = "here" ]; then
                 need_session mute; stop_all; mkdir -p "$SESSION_MUTE_DIR"; touch "$SESSION_MUTE_DIR/$CLAUDE_CODE_SESSION_ID"
                 echo "this session muted (! voice unmute here to undo)"
               else
                 stop_all; touch ~/.claude/.speak-off; echo "all sessions muted (voice unmute to undo)"
               fi ;;
  unmute|u)    if [ "$where" = "here" ]; then
                 need_session unmute; rm -f "$SESSION_MUTE_DIR/$CLAUDE_CODE_SESSION_ID"; echo "this session unmuted"
               else
                 rm -f ~/.claude/.speak-off; echo "all sessions unmuted"
               fi ;;
  read)        shift   # documents are readalong's job: github.com/venkatvyasam/readalong
               command -v readalong >/dev/null 2>&1 || { echo "voice read needs readalong: github.com/venkatvyasam/readalong"; exit 1; }
               exec readalong "$@" ;;
  speed)       # "voice speed" shows it; "voice speed 1.3", "voice speed +.2" or "voice speed reset" changes it
               if [[ "${2:-}" =~ $NUMBER ]] || [ "$where" = reset ]; then set_speed "$where"
               else echo "speed $(current_speed)x  (vo +.2 faster, vo -.1 slower, vo reset for the default)"; fi ;;
  reset)       set_speed reset ;;
  help|h)      usage ;;
  on-prompt)   # UserPromptSubmit hook: stop the old reply when you send a new message.
               # Silent on purpose: this hook's output would be added to Claude's context.
               # A message that is itself a voice command (e.g. "voice resume") must not stop the speech it targets.
               "$PY" -c 'import json, re, sys
p = json.load(sys.stdin).get("prompt") or ""
sys.exit(0 if re.match(r"\s*!?\s*(voice|vo)\b", p, re.I) else 1)' 2>/dev/null || stop_all
               exit 0 ;;
  *)           echo "voice: unknown command '$1' (nothing was changed)"; echo; usage; exit 1 ;;
esac
